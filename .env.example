# ─────────────────────────────────────────────────────────
#  xhampterr — Hedera Testnet environment
#
#  1. Get free Testnet credentials: https://portal.hedera.com/
#  2. Copy this file:  cp .env.example .env
#  3. Fill in your values below (never commit .env to Git)
# ─────────────────────────────────────────────────────────

# Your Testnet account ID  (format: 0.0.XXXXXXX)
OPERATOR_ID=0.0.XXXXXXX

# Your Testnet private key  (ECDSA hex string from the portal)
OPERATOR_KEY=0xYOUR_PRIVATE_KEY_HERE

# After running deploy.js, paste the returned Contract ID here
# so call.js can pick it up automatically.
CONTRACT_ID=0.0.10044781 # current started voting contract id 
